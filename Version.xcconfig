// The single source of truth for the app's marketing version.
//
// release-please rewrites the line below on every release. The trailing marker
// is what tells its `generic` updater which line to touch — without it the
// updater silently does nothing (see release-please-config.json).
//
// This lives in an xcconfig rather than in project.pbxproj because Xcode
// regenerates that file from its object graph whenever it saves, dropping any
// hand-written comment along with it. ci_scripts/check_version.sh guards the
// wiring.

MARKETING_VERSION = 0.5.0 // x-release-please-version
