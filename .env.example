# Copy to .env (never commit .env) and fill in real values.
# Used by `just notarize` — see ci_scripts/notarize.sh.

# Apple Developer Team ID. Xcode -> Settings -> Accounts -> select your team
# (shown in parentheses), or: security find-identity -v -p codesigning
CI_DEVELOPMENT_TEAM=

# From appstoreconnect.apple.com -> Users and Access -> Integrations ->
# App Store Connect API -> Team Keys. Generate a key with the "Developer"
# role if one doesn't already exist.
APP_STORE_CONNECT_API_KEY_ID=

# Same Team Keys page as above, shown at the top (shared by all keys).
APP_STORE_CONNECT_API_ISSUER_ID=

# base64 of the AuthKey_<key id>.p8 file downloaded when you generated the
# key above (only downloadable once, so save the original somewhere safe):
#   base64 -i AuthKey_<key id>.p8 | pbcopy
APP_STORE_CONNECT_API_PRIVATE_KEY=
